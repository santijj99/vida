# API Ventas (apirest) → Postgres compartido + licencias
SPRING_PROFILES_ACTIVE=prod
PORT=3000
VENTAS_PUBLISH_PORT=3000
VENTAS_BOOTSTRAP_DB=ventas_bootstrap

# Mismas credenciales que infra/postgres/.env
POSTGRES_USER=athland
POSTGRES_PASSWORD=CAMBIAR_password_fuerte_postgres

JWT_SECRET=CAMBIAR_jwt_ventas_minimo_32_caracteres_seguros!!
JWT_EXPIRATION_HOURS=24

LICENCIA_ENABLED=true
LICENCIA_MULTI_TENANT=true
# Nombre del contenedor de licencias en la red Docker
LICENCIA_SERVER_URL=http://licencias-api:8080
# DEBE ser igual a AES_KEY de licencias
LICENCIA_AES_KEY=0123456789abcdef0123456789abcdef
LICENCIA_BLOQUEAR=true

AFIP_HOMOLOGACION=true
JAVA_OPTS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=192m -XX:+UseG1GC
